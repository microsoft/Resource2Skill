# Copy to .env and fill in values for your environment.

# Azure OpenAI chat/completions or Responses endpoint.
# Example:
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=...

# Optional per-model overrides.
# AZURE_OPENAI_ENDPOINT_54=
# AZURE_OPENAI_DEPLOYMENT_54=gpt-5.4
# AZURE_OPENAI_API_VERSION_54=2024-12-01-preview
#
# AZURE_OPENAI_ENDPOINT_55=
# AZURE_OPENAI_DEPLOYMENT_55=gpt-5.5
# AZURE_OPENAI_API_VERSION_55=2024-12-01-preview

# If your Azure resource requires AAD instead of key auth:
# AZURE_OPENAI_USE_AAD=1

# Optional providers used by some collection/distillation utilities.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
